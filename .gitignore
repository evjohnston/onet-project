# Scraped pages and upstream bulk files - large, and re-fetched on demand.
data/cache/
# data/raw holds two very different kinds of thing, and blanket-ignoring it was
# treating them the same.
#
#   re-fetchable   data/raw/bulk is 132 MB of O*NET release archives and
#                  occupations.jsonl is scraped HTML. Both cost only time and
#                  politeness to reproduce, and neither belongs in git.
#   irreproducible the scoring checkpoints. Three passes, 1.8 MB, $8.86 of API
#                  spend - and a re-run would NOT give the same numbers, because
#                  sampling noise between two passes of the same model is 3.8
#                  points (METHODOLOGY.md 7.1). Losing these means losing the
#                  measurement, not just the money.
data/raw/*
!data/raw/subtask_scores.jsonl
!data/raw/retest/
data/raw/retest/*
!data/raw/retest/*/
data/raw/retest/*/*
!data/raw/retest/*/subtask_scores.jsonl

# Regenerable outputs. Everything here is rebuilt from the committed CSVs:
#   python -m onet_scraper report      -> sqlite tables, dashboard
#   python -m onet_scraper network     -> graphml
data/out/onet_stem.sqlite
data/out/*.graphml
data/out/occupations.json

# Filtered mirrors of O*NET descriptor files - large, and reproduced by
#   python -m onet_scraper fetch-descriptors && ... build
data/out/occupation_work_context.csv
data/out/occupation_work_activities.csv
data/out/occupation_abilities.csv
data/out/occupation_essential_skills.csv

# Local environment
.venv/
__pycache__/
*.pyc
.DS_Store

# Secrets. Nothing here is committable: this repo is public, and the scoring and
# retest stages both want an ANTHROPIC_API_KEY. Without these lines a key
# dropped in .env would be picked up by the next `git add -A`.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
